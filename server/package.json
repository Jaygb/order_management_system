    "helmet": "^7.1.0",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "prisma": "^5.18.0",
    "supertest": "^7.0.0",
    "vitest": "^2.0.5"
